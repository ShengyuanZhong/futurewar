executeCmd: cd /tmp/selfEvolutionTask/4-data-analysis/1-log-analysis && python3 << 'EOF'
import re
import json
from collections import defaultdict

errors = {"monitor": 0, "gateway": 0, "logistics": 0}
hour_counts = defaultdict(int)

# 1. Monitor: [YYYY-MM-DD HH:MM:SS] LEVEL ...
# Error if LEVEL is ERROR
with open('day1/monitor_2024-03-25.log') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        # Check if it's an error
        if '] ERROR ' in line:
            errors["monitor"] += 1
            # Extract hour
            m = re.search(r'\[(\d{4}-\d{2}-\d{2} (\d{2}):\d{2}:\d{2})\]', line)
            if m:
                hour = int(m.group(2))
                hour_counts[hour] += 1

# 2. Gateway: IP - - [DD/Mon/YYYY:HH:MM:SS +ZZZZ] "..." STATUS
# Error if STATUS >= 500
with open('day1/gateway_2024-03-25.log') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        # Extract status code (last number)
        parts = line.split()
        if parts:
            status_str = parts[-1]
            try:
                status = int(status_str)
                if status >= 500:
                    errors["gateway"] += 1
                    # Extract hour from [DD/Mon/YYYY:HH:MM:SS ...]
                    m = re.search(r'\[\d+/\w+/\d+:(\d{2}):\d{2}:\d{2}', line)
                    if m:
                        hour = int(m.group(1))
                        hour_counts[hour] += 1
            except ValueError:
                pass

# 3. Logistics: Mon DD HH:MM:SS host daemon: SIGNAL detail
# Error if starts with OOM-killer / disk-full / net-down (after 'daemon: ')
with open('day1/logistics_2024-03-25.log') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        # Check if it contains the error signals
        if ': OOM-killer ' in line or ': disk-full ' in line or ': net-down ' in line:
            errors["logistics"] += 1
            # Extract hour
            m = re.search(r'^\w+ \d+ (\d{2}):\d{2}:\d{2}', line)
            if m:
                hour = int(m.group(1))
                hour_counts[hour] += 1

# Find peak hour
peak_hour = 0
peak_count = 0
for h in sorted(hour_counts.keys()):
    if hour_counts[h] > peak_count:
        peak_count = hour_counts[h]
        peak_hour = h

result = {
    "errors": errors,
    "peak_hour": f"{peak_hour}时",
    "peak_count": peak_count
}

print(json.dumps(result))
