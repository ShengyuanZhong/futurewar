  4. cd /tmp/selfEvolutionTask/1-fixed-step/4-script-dev && cat > solve.py << 'PYEOF'
import json

def transform(records):
    # 1. Filter: disabled must be false
    active = [r for r in records if not r.get('disabled', False)]
    
    # 2. Group by category and sum amount
    category_amounts = {}
    for r in active:
        cat = r['category']
        amt = r['amount']
        if cat in category_amounts:
            category_amounts[cat] += amt
        else:
            category_amounts[cat] = amt
    
    # 3. Create result list
    result = [{'category': cat, 'amount': amt} for cat, amt in category_amounts.items()]
    
    # 4. Sort by category alphabetically
    result.sort(key=lambda x: x['category'])
    
    return result

# Main execution
with open('work/input_s1.json', 'r') as f:
    data = json.load(f)

result = transform(data)

with open('work/result_s1.json', 'w') as f:
    json.dump(result, f, indent=2)

print(f"Processed {len(data)} records, output {len(result)} categories")
print(json.dumps(result[:3], indent=2))
