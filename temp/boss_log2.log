executeCmd: cd /tmp/selfEvolutionTask/1-fixed-step/4-script-dev && cat > solve.py << 'EOF'
import json

def transform(records):
    # 1. Filter: disabled must be false
    active = [r for r in records if not r.get('disabled', False)]
    
    # 2. Group by category and sum amount
    stats = {}
    for r in active:
        cat = r['category']
        stats[cat] = stats.get(cat, 0) + r['amount']
    
    # 3. Convert to list and sort by category (alphabetical)
    result = [{"category": cat, "amount": amt} for cat, amt in stats.items()]
    result.sort(key=lambda x: x['category'])
    
    return result

if __name__ == '__main__':
    with open('work/input_s1.json', 'r') as f:
        data = json.load(f)
    
    output = transform(data)
    
    with open('work/result_s1.json', 'w') as f:
        json.dump(output, f, indent=2)
    
    print("Done. Generated result_s1.json")
EOF
