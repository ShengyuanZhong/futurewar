executeCmd: python3 << 'EOF'
import re
from collections import defaultdict

errors = {"monitor": 0, "gateway": 0, "logistics": 0}
hour_counts = defaultdict(int)

# Parse Monitor logs
with open('/tmp/selfEvolutionTask/4-data-analysis/1-log-analysis/day1/monitor_2024-03-25.log') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        if '] ERROR' in line:
            errors["monitor"] += 1
            m = re.search(r'\[(\d{4}-\d{2}-\d{2} (\d{2}):', line)
            if m:
                hour_counts[m.group(2)] += 1

# Parse Gateway logs
with open('/tmp/selfEvolutionTask/4-data-analysis/1-log-analysis/day1/gateway_2024-03-25.log') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        m = re.search(r'\[(\d{2}/\w+/\d{4}):(\d{2}):', line)
        status_m = re.search(r'" (\d{3})', line)
        if status_m and int(status_m.group(1)) >= 500:
            errors["gateway"] += 1
            if m:
                hour_counts[m.group(2)] += 1

# Parse Logistics logs
with open('/tmp/selfEvolutionTask/4-data-analysis/1-log-analysis/day1/logistics_2024-03-25.log') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        if any(line.endswith(sig) or 'daemon: ' + sig in line for sig in ['OOM-killer', 'disk-full', 'net-down']):
             # Check if the signal part starts with these keywords
             if re.search(r'daemon:\s*(OOM-killer|disk-full|net-down)', line):
                errors["logistics"] += 1
                m = re.search(r'\w+ \d+ (\d{2}):', line)
                if m:
                    hour_counts[m.group(1)] += 1

# Find peak hour
peak_hour_key = max(hour_counts, key=lambda k: (hour_counts[k], -int(k))) if hour_counts else '00'
peak_count = hour_counts[peak_hour_key] if hour_counts else 0
peak_hour_str = f"{int(peak_hour_key):02d}时"

result = {
    "errors": errors,
    "peak_hour": peak_hour_str,
    "peak_count": peak_count
}
print(result)
