    print(f"Sample record: {json.dumps(all_records[0], ensure_ascii=False)}")
    
    # Calculate stats
    total_count = len(all_records)
    world_heritage_count = sum(1 for r in all_records if r.get('protection_level') == '世界遗产' or r.get('level') == '世界遗产')
    types = list(set(r.get('type', '') for r in all_records if r.get('type')))
    
    # Find oldest era - need to check era fields
    # Print all unique era values and related fields to identify the correct field
    era_values = set()
    for r in all_records:
        for k, v in r.items():
            if 'era' in k.lower() or 'date' in k.lower() or 'year' in k.lower():
                era_values.add(f"{k}={v}")
    print(f"Era/Date fields: {era_values}")
    
    # Try to find oldest based on common field names
    oldest = None
    for field in ['era', 'dynasty', 'period', 'century', 'year']:
        if any(field in r for r in all_records):
            # Sort by this field if possible
            try:
                sorted_records = sorted(all_records, key=lambda r: str(r.get(field, '')))
                oldest = sorted_records[0]
                print(f"Oldest by {field}: {oldest.get('name')}, value={oldest.get(field)}")
                break
            except:
                pass
    
    result = {
        "city": "北京",
        "total_count": total_count,
        "world_heritage_count": world_heritage_count,
        "types": sorted(types),
        "oldest_era": oldest.get('name') if oldest else ''
    }
    print(f"RESULT: {json.dumps(result, ensure_ascii=False)}")
else:
    print("No records found")
