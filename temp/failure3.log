executeCmd: python3 - <<'PY'
import urllib.request, json, urllib.parse

base = "http://localhost:8899/api/v1/heritage/search"
headers = {"Authorization": "Bearer heritage-api-key-2024"}

# Fetch all records with pagination for 南京
all_records = []
page = 1
while True:
    url = f"{base}?city={urllib.parse.quote('南京')}&page={page}&per_page=100"
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read().decode('utf-8')
            data = json.loads(raw)
            if page == 1:
                print(f"Response keys: {list(data.keys())}")
                if 'data' in data and isinstance(data['data'], list) and data['data']:
                    print(f"First record keys: {list(data['data'][0].keys())}")
                    print(f"Total in response: {data.get('total')}")
                    print(f"Sample record: {json.dumps(data['data'][0], ensure_ascii=False)}")
            
            records = data.get('data', [])
            if not isinstance(records, list):
                records = []
            if not records:
                break
            all_records.extend(records)
            total = data.get('total', 0)
            if len(all_records) >= total or len(records) < 100:
                break
            page += 1
    except Exception as e:
        print(f"Error at page {page}: {e}")
        # Try to read error body
        if hasattr(e, 'read'):
            print(e.read().decode('utf-8', errors='ignore'))
        break

print(f"Total fetched: {len(all_records)}")
if all_records:
    # Stats
    total_count = len(all_records)
    world_heritage_count = sum(1 for r in all_records if r.get('protection_level') == '世界遗产' or r.get('level') == '世界遗产')
    types = sorted(list(set(r.get('type', '') for r in all_records if r.get('type'))))
    
    # Find oldest era - check available era fields
    era_fields = set()
    for r in all_records:
        for k in r:
            if 'era' in k.lower() or 'dynasty' in k.lower() or 'period' in k.lower() or 'century' in k.lower():
                era_fields.add(k)
    print(f"Era fields found: {era_fields}")
    
    oldest_name = ""
    for field in list(era_fields):
        # Sort by this field to find oldest
        sorted_recs = sorted(all_records, key=lambda r: str(r.get(field, '')))
        oldest_name = sorted_recs[0].get('name', '')
        print(f"Oldest by {field}: {oldest_name} ({sorted_recs[0].get(field)})")
        break
    
    result = {
        "city": "南京",
        "total_count": total_count,
        "world_heritage_count": world_heritage_count,
        "types": types,
        "oldest_era": oldest_name
    }
    print(f"RESULT: {json.dumps(result, ensure_ascii=False)}")
else:
    print("No records found")
