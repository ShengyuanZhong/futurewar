import urllib.request, json, urllib.parse

base = "http://localhost:8899/api/v1/heritage/search"
headers = {"Authorization": "Bearer heritage-api-key-2024"}

all_records = []
page = 1
while True:
    url = f"{base}?location={urllib.parse.quote('南京')}&page={page}&per_page=100"
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read().decode('utf-8')
            data = json.loads(raw)
            if page == 1:
                print(f"Response keys: {list(data.keys())}")
                # Debug: print full raw response structure for first page to understand 'data' field
                if 'data' in data:
                    d = data['data']
                    if isinstance(d, list):
                        print(f"Data is list, length: {len(d)}")
                        if d:
                            print(f"First record keys: {list(d[0].keys())}")
                            print(f"First record sample: {json.dumps(d[0], ensure_ascii=False)}")
                    elif isinstance(d, dict):
                        print(f"Data is dict, keys: {list(d.keys())}")
                        # Check if records are nested inside, e.g., d['records'] or similar
                        for k, v in d.items():
                            if isinstance(v, list):
                                print(f"Found list in data['{k}'], length: {len(v)}")
                                if v:
                                    print(f"Nested record keys: {list(v[0].keys())}")
                print(f"Total from response: {data.get('total')}")
            
            # Extract records
            records = []
            d = data.get('data')
            if isinstance(d, list):
                records = d
            elif isinstance(d, dict):
                # Try common keys or find the list value
                for k, v in d.items():
                    if isinstance(v, list):
                        records = v
                        break
            
            if not records:
                break
            
            all_records.extend(records)
            total = data.get('total', 0)
            if len(all_records) >= total or len(records) < 100:
                break
            page += 1
    except Exception as e:
        print(f"Error at page {page}: {e}")
        break

print(f"Total fetched: {len(all_records)}")

if all_records:
    total_count = len(all_records)
    
    # Identify fields
    sample = all_records[0]
    print(f"Sample keys: {list(sample.keys())}")
    
    # Protection level
    prot_field = None
    for k in sample:
        if 'level' in k.lower() or 'protection' in k.lower():
            prot_field = k
            break
    print(f"Prot field: {prot_field}")
    wh_count = sum(1 for r in all_records if r.get(prot_field) == '世界遗产') if prot_field else 0
    
    # Types
    type_field = None
    for k in sample:
        if 'type' in k.lower():
            type_field = k
            break
    print(f"Type field: {type_field}")
    types = sorted(list(set(r.get(type_field, '') for r in all_records if r.get(type_field)))) if type_field else []
    
    # Oldest Era
    era_field = None
    for k in sample:
        if 'era' in k.lower() or 'dynasty' in k.lower() or 'period' in k.lower() or 'century' in k.lower() or 'date' in k.lower():
            era_field = k
            break
    print(f"Era field: {era_field}")
    
    oldest_name = ""
    if era_field:
        # Sort by era field. Assuming string sort works or numeric.
        # If it's a year/number, min() works. If string like "Ming", need specific logic.
        # Let's see unique values first
        unique_eras = set(r.get(era_field, '') for r in all_records)
        print(f"Unique eras: {unique_eras}")
        
        # Try to find min. If numeric, convert. If string, assume chronological order might not be alpha.
        # However, usually 'era' implies a string like 'Ming', 'Qing'. 'oldest' implies earliest.
        # Let's try sorting by the value directly first.
        sorted_recs = sorted(all_records, key=lambda r: str(r.get(era_field, '')))
        oldest_name = sorted_recs[0].get('name', '')
        print(f"Oldest by {era_field} (alpha sort): {oldest_name} ({sorted_recs[0].get(era_field)})")
        
        # If era is numeric (year), this works. If it's dynasty name, we might need a map.
        # But without a map, alpha sort is the best guess unless we see the data.
        # Let's check if the field looks like a year.
        
    result = {
        "city": "南京",
        "total_count": total_count,
        "world_heritage_count": wh_count,
        "types": types,
        "oldest_era": oldest_name
    }
    print(f"RESULT: {json.dumps(result, ensure_ascii=False)}")
else:
    print("No records found")
