import urllib.request, json, urllib.parse

base = "http://localhost:8899/api/v1/heritage/search"
headers = {"Authorization": "Bearer heritage-api-key-2024"}

# Fetch all records with pagination
all_records = []
page = 1
while True:
    url = f"{base}?city={urllib.parse.quote('北京')}&page={page}&per_page=100"
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode('utf-8'))
            records = data.get('data', [])
            if not records:
                break
            all_records.extend(records)
            total = data.get('total', 0)
            if len(all_records) >= total:
                break
            page += 1
    except Exception as e:
        print(f"Error at page {page}: {e}")
        break

print(f"Total fetched: {len(all_records)}")
if all_records:
    print(f"Sample record keys: {list(all_records[0].keys())}")
    print(f"Sample record: {json.dumps(all_records[0], ensure_ascii=False)}")
    
    # Calculate stats
    total_count = len(all_records)
    world_heritage_count = sum(1 for r in all_records if r.get('protection_level') == '世界遗产' or r.get('level') == '世界遗产')
    types = list(set(r.get('type', '') for r in all_records if r.get('type')))
    
    # Find oldest era - need to check era fields
    # Print all unique era values and related fields to identify the correct field
    era_values = set()
    for r in all_records:
        for k, v in r.items():
            if 'era' in k.lower() or 'date' in k.lower() or 'year' in k.lower():
                era_values.add(f"{k}={v}")
    print(f"Era/Date fields: {era_values}")
    
    # Try to find oldest based on common field names
    oldest = None
