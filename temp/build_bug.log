executeCmd: cd /tmp/selfEvolutionTask/1-fixed-step/4-script-dev && cat work/input_s1.json | python3 -c "import sys,json; data=json.load(sys.stdin); print(len(data)); print(json.dumps(data[:2], indent=2))" && cat test_cases/s1_cases.json | python3 -c "
import sys, json
cases = json.load(sys.stdin)['cases']
for i, c in enumerate(cases):
    inp = c['input']
    exp = c['expected']
    # Filter: disabled=false
    active = [r for r in inp if not r.get('disabled', False)]
    # Group by category, sum amount
    from collections import defaultdict
    groups = defaultdict(int)
    for r in active:
        groups[r['category']] += r['amount']
    # Sort by category alphabetically
    sorted_cats = sorted(groups.keys())
    expected_sorted = [(e['category'], e['amount']) for e in exp]
    computed = [(cat, groups[cat]) for cat in sorted_cats]
    match = computed == expected_sorted
    print(f'Case {i}: match={match}, computed={computed}, expected={expected_sorted}')
"
