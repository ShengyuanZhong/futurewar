import re
from collections import defaultdict

errors = {"monitor": 0, "gateway": 0, "logistics": 0}
hour_counts = defaultdict(int)

# Monitor logs: [2024-03-25 08:46:00] ERROR ...
with open("/tmp/selfEvolutionTask/4-data-analysis/1-log-analysis/day1/monitor_2024-03-25.log") as f:
    for line in f:
        if " ERROR " in line:
            errors["monitor"] += 1
            m = re.search(r'\[\d{4}-\d{2}-\d{2} (\d{2}):\d{2}:\d{2}\]', line)
            if m:
                hour_counts[m.group(1)] += 1

# Gateway logs: ... [25/Mar/2024:09:17:00 +0800] "GET ..." 200
with open("/tmp/selfEvolutionTask/4-data-analysis/1-log-analysis/day1/gateway_2024-03-25.log") as f:
    for line in f:
        parts = line.strip().rsplit(' ', 1)
        if len(parts) == 2:
            try:
                status = int(parts[1])
                if status >= 500:
                    errors["gateway"] += 1
                    m = re.search(r'\[\d{2}/\w+/\d{4}:(\d{2}):\d{2}:\d{2} [^\]]+\]', line)
                    if m:
                        hour_counts[m.group(1)] += 1
            except ValueError:
                pass

# Logistics logs: Mar 25 10:31:00 ... OOM-killer ...
with open("/tmp/selfEvolutionTask/4-data-analysis/1-log-analysis/day1/logistics_2024-03-25.log") as f:
    for line in f:
        stripped = line.strip()
        # Check if line starts with the error signals after the daemon part
        # Format: Mon DD HH:MM:SS host daemon: SIGNAL details
        # We look for OOM-killer, disk-full, net-down anywhere in the line as per task desc
        if re.search(r'\b(OOM-killer|disk-full|net-down)\b', stripped):
            errors["logistics"] += 1
            m = re.search(r'^\w+ \d+ (\d{2}):\d{2}:\d{2}', stripped)
            if m:
                hour_counts[m.group(1)] += 1

if hour_counts:
    peak_hour = min(hour_counts, key=lambda h: (-hour_counts[h], h))
    peak_count = hour_counts[peak_hour]
else:
    peak_hour = "00"
    peak_count = 0

result = {
    "errors": errors,
    "peak_hour": f"{peak_hour}\u65f6",
    "peak_count": peak_count
}

import json
print(json.dumps(result))
