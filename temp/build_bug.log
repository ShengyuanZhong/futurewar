executeCmd: python3 << 'PYEOF'
import re
from collections import defaultdict

by_type = {"error": 0, "http500": 0, "oom": 0}
module_counts = defaultdict(int)

base = "/tmp/selfEvolutionTask/4-data-analysis/1-log-analysis/day2"

# Monitor logs: [2024-06-12 ...] ERROR ... module=...
with open(f"{base}/monitor_2024-06-12.log") as f:
    for line in f:
        if " ERROR " in line:
            by_type["error"] += 1
            m = re.search(r'module=(\S+)', line)
            if m:
                module_counts[m.group(1)] += 1

# Gateway logs: ... [12/Jun/2024:... ... "GET ..." 5xx
with open(f"{base}/gateway_2024-06-12.log") as f:
    for line in f:
        parts = line.strip().rsplit(' ', 1)
        if len(parts) == 2:
            try:
                status = int(parts[1])
                if 500 <= status <= 599:
                    by_type["http500"] += 1
            except ValueError:
                pass

# Logistics logs: ... OOM-killer ... / disk-full ... / net-down ...
with open(f"{base}/logistics_2024-06-12.log") as f:
    for line in f:
        stripped = line.strip()
        if re.search(r'\b(OOM-killer|disk-full|net-down)\b', stripped):
            by_type["oom"] += 1

total_failures = by_type["error"] + by_type["http500"] + by_type["oom"]

if module_counts:
    top_module = max(module_counts, key=module_counts.get)
    top_module_count = module_counts[top_module]
else:
    top_module = ""
    top_module_count = 0

result = {
    "total_failures": total_failures,
    "by_type": by_type,
    "top_module": top_module,
    "top_module_count": top_module_count
}

import json
print(json.dumps(result))
