cmd: cd /tmp/selfEvolutionTask/1-fixed-step/4-script-dev && cat > solve.py << 'EOF'
import json

def transform(records):
    # Filter out disabled records
    active = [r for r in records if not r.get('disabled', False)]
    
    # Group by category and sum amount
    from collections import defaultdict
    groups = defaultdict(int)
    for r in active:
        groups[r['category']] += r['amount']
    
    # Sort by category alphabetically
    result = []
    for cat in sorted(groups.keys()):
        result.append({"category": cat, "amount": groups[cat]})
    
    return result

# Read input
with open('work/input_s1.json', 'r') as f:
    data = json.load(f)

# Transform
result = transform(data)

# Write output
with open('work/result_s1.json', 'w') as f:
    json.dump(result, f, indent=2)

print(f"Processed {len(data)} records into {len(result)} categories")
EOF
