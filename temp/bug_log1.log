import re
from collections import defaultdict

errors = {"monitor": 0, "gateway": 0, "logistics": 0}
hour_counts = defaultdict(int)

# Parse Monitor logs
with open('monitor_2024-03-25.log') as f:
    for line in f:
        if ' ERROR ' in line:
            errors['monitor'] += 1
            m = re.search(r'\[\d{4}-\d{2}-\d{2} (\d{2}):', line)
            if m:
                hour_counts[m.group(1)] += 1

# Parse Gateway logs
with open('gateway_2024-03-25.log') as f:
    for line in f:
        parts = line.strip().split('"')
        if len(parts) >= 3:
            status = int(parts[2].strip().split()[0])
            if status >= 500:
                errors['gateway'] += 1
                m = re.search(r'\[\d+/\w+/\d+:\d{2}:', line)
                if m:
                    hour_counts[m.group(0)[-2:]] += 1

# Parse Logistics logs
with open('logistics_2024-03-25.log') as f:
    for line in f:
        if any(line.find(sig) != -1 for sig in ['OOM-killer', 'disk-full', 'net-down']):
            errors['logistics'] += 1
            m = re.search(r'\w+ \d+ (\d{2}):', line)
            if m:
                hour_counts[m.group(1)] += 1

# Find peak hour
peak_hour_str = max(hour_counts, key=lambda h: (hour_counts[h], -int(h))) if hour_counts else '00'
peak_count = hour_counts[peak_hour_str]

import json
result = {
    "errors": errors,
    "peak_hour": f"{peak_hour_str}时",
    "peak_count": peak_count
}
print(json.dumps(result))
EOF
