executeCmd: cd /tmp/selfEvolutionTask/4-data-analysis/1-log-analysis/day1/ && python3 << 'EOF'
import re
from collections import defaultdict

errors = {"monitor": 0, "gateway": 0, "logistics": 0}
hour_counts = defaultdict(int)

# Parse Monitor logs
with open('monitor_2024-03-25.log') as f:
    for line in f:
        if ' ERROR ' in line:
            errors['monitor'] += 1
            m = re.search(r'\[\d{4}-\d{2}-\d{2} (\d{2}):', line)
            if m:
                hour_counts[m.group(1)] += 1

# Parse Gateway logs
with open('gateway_2024-03-25.log') as f:
    for line in f:
        parts = line.strip().split('"')
        if len(parts) >= 3:
            status_str = parts[2].strip().split()[0]
            try:
                status = int(status_str)
            except ValueError:
                continue
            if status >= 500:
                errors['gateway'] += 1
                m = re.search(r'\[\d+/\w+/\d+:(\d{2}):', line)
                if m:
                    hour_counts[m.group(1)] += 1

# Parse Logistics logs
with open('logistics_2024-03-25.log') as f:
    for line in f:
        if any(sig in line for sig in ['OOM-killer', 'disk-full', 'net-down']):
            errors['logistics'] += 1
            m = re.search(r'\w+ \d+ (\d{2}):', line)
            if m:
                hour_counts[m.group(1)] += 1

# Find peak hour
if hour_counts:
    # Sort by count desc, then hour asc (earlier hour wins ties)
    peak_hour_str = sorted(hour_counts.items(), key=lambda x: (-x[1], x[0]))[0][0]
    peak_count = hour_counts[peak_hour_str]
else:
    peak_hour_str = '00'
    peak_count = 0

import json
result = {
    "errors": errors,
    "peak_hour": f"{peak_hour_str}\u65f6",
    "peak_count": peak_count
}
print(json.dumps(result))
