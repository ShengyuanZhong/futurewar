cmd: python3 -c "
import requests, json

base_url = 'http://localhost:8899/api/v1/heritage/search'
headers = {'Authorization': 'Bearer heritage-api-key-2024'}

all_records = []
offset = 0
limit = 100  # Try to get all in one go or check pagination

while True:
    params = {'location': '北京', 'offset': offset, 'limit': limit}
    resp = requests.get(base_url, headers=headers, params=params)
    data = resp.json()
    
    if 'error' in data or data.get('code') != 200:
        print(f'Error: {data}')
        break
    
    records = data['data']['records']
    all_records.extend(records)
    
    pagination = data['data']['pagination']
    total_count = pagination['total_count']
    
    if offset + len(records) >= total_count:
        break
    
    offset += len(records)

# Calculate statistics
total_count = len(all_records)
world_heritage_count = sum(1 for r in all_records if r.get('protected_level') == '世界遗产')
types = list(set(r.get('type') for r in all_records))

# Find oldest era
# Need to define an order for eras to determine 'oldest'
# Common Chinese historical era order:
era_order = {
    '旧石器时代': 1,
    '新石器时代': 2,
    '夏': 3,
    '商': 4,
    '周': 5,
    '春秋': 6,
    '战国': 7,
    '秦': 8,
    '汉': 9,
    '三国': 10,
    '晋': 11,
    '南北朝': 12,
    '隋': 13,
    '唐': 14,
    '五代': 15,
    '宋': 16,
    '辽': 17,
    '金': 18,
    '元': 19,
    '明': 20,
    '清': 21,
    '明清': 22,
    '元明清': 23,
    '辽金元明清': 24,
    '近代': 25
}

def get_era_rank(era_str):
    # Handle combined eras like '辽金元明清' by taking the earliest component
    # Simple heuristic: split by common separators or just match against known eras
    # Let's try to find the earliest era mentioned in the string
    min_rank = float('inf')
    for key in era_order:
        if key in era_str:
            min_rank = min(min_rank, era_order[key])
    return min_rank if min_rank != float('inf') else 999

oldest_record = min(all_records, key=lambda r: get_era_rank(r.get('era', '')))
oldest_era_name = oldest_record['name']

result = {
    'city': '北京',
    'total_count': total_count,
    'world_heritage_count': world_heritage_count,
    'types': types,
    'oldest_era': oldest_era_name
}

print(json.dumps(result, ensure_ascii=False))
"
