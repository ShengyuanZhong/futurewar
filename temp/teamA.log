#!/bin/sh
# ./check — 触发 chroot 外 nobody 验证服务（本队 netns 127.0.0.1:8899/check）。
# v7.0：RULES/TOKEN 在 chroot 外 nobody(65534) 进程内存，选手读不到源码/内存。
python3 -c 'import urllib.request,sys
try:
    sys.stdout.write(urllib.request.urlopen("http://127.0.0.1:8899/check",timeout=60).read().decode())
except Exception as e:
    sys.stderr.write("[ERROR] 无法连接验证服务（确认 prepare 成功）: %s\n" % e); sys.exit(1)
' || curl -s --max-time 60 http://127.0.0.1:8899/check || echo "[ERROR] 验证服务不可达"

