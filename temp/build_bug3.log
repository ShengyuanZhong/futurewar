cmd: cd /tmp/selfEvolutionTask/1-fixed-step/4-script-dev && cat > solve.py << 'EOF'
import json

def transform(records):
    # Filter out disabled records
    active = [r for r in records if not r.get('disabled', False)]
    
    # Group by category and sum amounts
    groups = {}
    for r in active:
        cat = r['category']
        amt = r['amount']
        if cat not in groups:
            groups[cat] = 0
        groups[cat] += amt
    
    # Build result list
    result = []
    for cat, total in groups.items():
        result.append({"category": cat, "amount": total})
    
    # Sort by category ascending (alphabetical)
    result.sort(key=lambda x: x['category'])
    
    return result

# Load input
with open('work/input_s1.json', 'r') as f:
    data = json.load(f)

# Transform
output = transform(data)

# Write result
with open('work/result_s1.json', 'w') as f:
    json.dump(output, f, indent=2)

print("Done. Output written to work/result_s1.json")
