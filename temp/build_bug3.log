import re
from collections import defaultdict

total_failures = 0
by_type = {"error": 0, "http500": 0, "oom": 0}
module_counts = defaultdict(int)

# Monitor: [2024-06-12 08:46:00] ERROR ... module=xxx
with open("monitor_2024-06-12.log") as f:
    for line in f:
        line = line.strip()
        if not line: continue
        if re.search(r"\]\s+ERROR\s+", line):
            total_failures += 1
            by_type["error"] += 1
            m = re.search(r"module=([\w-]+)", line)
            if m:
                module_counts[m.group(1)] += 1

# Gateway: IP - - [12/Jun/2024:09:17:00 +0800] "GET ..." 500
with open("gateway_2024-06-12.log") as f:
    for line in f:
        line = line.strip()
        if not line: continue
        parts = line.split()
        if parts:
            try:
                status = int(parts[-1])
                if status >= 500:
                    total_failures += 1
                    by_type["http500"] += 1
            except ValueError:
                pass

# Logistics: Jun 12 10:31:00 camp-server daemon: OOM-killer ...
with open("logistics_2024-06-12.log") as f:
    for line in f:
        line = line.strip()
        if not line: continue
        if re.search(r"daemon:\s+(OOM-killer|disk-full|net-down)", line):
            total_failures += 1
            by_type["oom"] += 1

# Find top module
top_module = ""
top_module_count = 0
for mod, cnt in module_counts.items():
    if cnt > top_module_count:
        top_module_count = cnt
        top_module = mod

result = {
    "total_failures": total_failures,
    "by_type": by_type,
    "top_module": top_module,
    "top_module_count": top_module_count
}
print(result)
