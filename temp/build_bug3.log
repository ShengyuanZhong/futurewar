import re
from collections import defaultdict

errors = {"monitor": 0, "gateway": 0, "logistics": 0}
hour_counts = defaultdict(int)

# Monitor: [2024-03-25 08:46:00] ERROR ...
with open("monitor_2024-03-25.log") as f:
    for line in f:
        line = line.strip()
        if not line: continue
        # Check for ERROR level
        if re.search(r"\]\s+ERROR\s+", line):
            errors["monitor"] += 1
            # Extract hour
            m = re.match(r"\[(\d{4}-\d{2}-\d{2})\s+(\d{2}):\d{2}:\d{2}\]", line)
            if m:
                hour_counts[int(m.group(2))] += 1

# Gateway: IP - - [25/Mar/2024:09:17:00 +0800] "GET ..." 500
with open("gateway_2024-03-25.log") as f:
    for line in f:
        line = line.strip()
        if not line: continue
        # Extract status code (last number)
        parts = line.split()
        if parts:
            try:
                status = int(parts[-1])
                if status >= 500:
                    errors["gateway"] += 1
                    # Extract hour from [25/Mar/2024:HH:MM:SS
                    m = re.search(r"\[\d{2}/\w+/\d{4}:(\d{2}):\d{2}:\d{2}", line)
                    if m:
                        hour_counts[int(m.group(1))] += 1
            except ValueError:
                pass

# Logistics: Mar 25 10:31:00 camp-server daemon: OOM-killer ...
with open("logistics_2024-03-25.log") as f:
    for line in f:
        line = line.strip()
        if not line: continue
        # Check if it starts with OOM-killer / disk-full / net-down after "daemon: "
        if re.search(r"daemon:\s+(OOM-killer|disk-full|net-down)", line):
            errors["logistics"] += 1
            # Extract hour: Mar 25 HH:MM:SS
            m = re.match(r"\w+ \d+ (\d{2}):\d{2}:\d{2}", line)
            if m:
                hour_counts[int(m.group(1))] += 1

# Find peak hour
peak_hour = None
peak_count = 0
for h in sorted(hour_counts.keys()):
    if hour_counts[h] > peak_count:
        peak_count = hour_counts[h]
        peak_hour = h

result = {
    "errors": errors,
    "peak_hour": f"{peak_hour}时",
    "peak_count": peak_count
}
print(result)
'
