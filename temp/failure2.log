import json

with open('/tmp/chengdu_raw.json', 'r') as f:
    data = json.load(f)

print('TOP_KEYS:', list(data.keys()))
print('STATUS:', data.get('status'))
print('MSG:', data.get('message'))

# Handle nested structure based on previous experience
if data.get('status') == 'success':
    # Check if records are directly in data or nested in data['data']
    if 'records' in data:
        records = data['records']
    elif 'data' in data and isinstance(data['data'], dict) and 'records' in data['data']:
        records = data['data']['records']
    else:
        records = []
        print('WARNING: Could not locate records array')
else:
    records = []
    print('ERROR: Status not success')

print('TOTAL_RECORDS:', len(records))
if records:
    print('FIRST_RECORD:', json.dumps(records[0], ensure_ascii=False))
    
    # Calculate stats
    world_count = sum(1 for r in records if r.get('protected_level') == '世界遗产')
    types = sorted(list(set(r.get('type', '') for r in records)))
    
    # Define era ordering to find oldest
    era_order = {
        '先秦': 1, '夏': 1, '商': 2, '周': 3, '春秋': 4, '战国': 5,
        '秦': 6, '汉': 7, '三国': 8, '晋': 9, '南北朝': 10,
        '隋': 11, '唐': 12, '五代': 13, '宋': 14, '元': 15,
        '明': 16, '清': 17, '民国': 18, '现代': 19, '当代': 20
    }
    
    def get_era_score(era_str):
        for k, v in era_order.items():
            if k in era_str:
                return v
        return 999
    
    oldest_name = ''
    min_score = 999
    for r in records:
        era = r.get('era', '')
        score = get_era_score(era)
        if score < min_score:
            min_score = score
            oldest_name = r.get('name', '')
    
    print('WORLD_HERITAGE_COUNT:', world_count)
    print('TYPES:', types)
    print('OLDEST_ERA_NAME:', oldest_name)
    
    # Construct final answer
    ans = {
        'city': '成都',
        'total_count': len(records),
        'world_heritage_count': world_count,
        'types': types,
        'oldest_era': oldest_name
    }
    print('FINAL_ANSWER:', json.dumps(ans, ensure_ascii=False))
else:
    print('No records found')
