f rank < min_rank:\n        min_rank = rank\n        oldest_record = r\n\noldest_era_name = oldest_record[\"name\"] if oldest_record else \"\"\n\nresult = {\n    \"city\": \"北京\",\n    \"total_count\": total,\n    \"world_heritage_count\": world_heritage_count,\n    \"types\": types,\n    \"oldest_era\": oldest_era_name\n}\n\nprint(json.dumps(result, ensure_ascii=False))\nPY"}
