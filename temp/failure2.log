import json

# Load the raw JSON from previous step
with open('/tmp/nanjing_raw.json', 'r') as f:
    data = json.load(f)

# Extract records
data_obj = data.get('data', {})
records = data_obj.get('records', [])

total_count = len(records)
world_heritage_count = sum(1 for r in records if r.get('protected_level') == '世界遗产')
types = sorted(list(set(r.get('type', '') for r in records)))

# Define era ordering
era_order = {
    '先秦': 1, '夏': 1, '商': 2, '周': 3, '春秋': 4, '战国': 5,
    '秦': 6, '汉': 7, '三国': 8, '晋': 9, '南北朝': 10,
    '隋': 11, '唐': 12, '五代': 13, '宋': 14, '元': 15,
    '明': 16, '清': 17, '民国': 18, '现代': 19, '当代': 20
}

def get_era_score(era_str):
    for k, v in era_order.items():
        if k in era_str:
            return v
    return 999

oldest_name = ''
min_score = 999
for r in records:
    era = r.get('era', '')
    score = get_era_score(era)
    if score < min_score:
        min_score = score
        oldest_name = r.get('name', '')

ans = {
    'city': '南京',
    'total_count': total_count,
    'world_heritage_count': world_heritage_count,
    'types': types,
    'oldest_era': oldest_name
}

print('FINAL_ANSWER:', json.dumps(ans, ensure_ascii=False))
