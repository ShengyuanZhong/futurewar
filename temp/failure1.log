import urllib.request
import json
from urllib.parse import quote

base = "http://localhost:8899"
key = "heritage-api-key-2024"

# Try multiple endpoint variations and auth methods
endpoints = [
    f"{base}/api/v1/heritage/search",
    f"{base}/api/v1/heritages/search",
    f"{base}/api/v1/heritage",
    f"{base}/api/heritage/search",
]

auth_headers = [
    {"Authorization": f"Bearer {key}"},
    {"X-API-Key": key},
]

city = quote("北京", encoding='utf-8')

for ep in endpoints:
    for auth in auth_headers:
        url = f"{ep}?city={city}&page=1&limit=100"
        req = urllib.request.Request(url)
        for k, v in auth.items():
            req.add_header(k, v)
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                raw = resp.read().decode('utf-8')
                print(f"SUCCESS: {url}", flush=True)
                print(f"Response: {raw[:1000]}", flush=True)
                # Save for next step
                with open("/tmp/api_result.json", "w") as f:
                    f.write(raw)
                exit(0)
        except Exception as e:
            print(f"FAIL {url} with {auth}: {e}", flush=True)

print("All attempts failed", flush=True)
