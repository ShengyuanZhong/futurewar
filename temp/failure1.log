import urllib.request
import json
from urllib.parse import quote

base = "http://localhost:8899"
key = "heritage-api-key-2024"

# Fetch all Nanjing heritage records
all_records = []
page = 1
while True:
    city_encoded = quote("南京", encoding='utf-8')
    url = f"{base}/api/v1/heritage/search?city={city_encoded}&page={page}&limit=100"
    req = urllib.request.Request(url)
    req.add_header("X-API-Key", key)
    
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode('utf-8'))
            
            # Extract records
            if "records" in data:
                records = data["records"]
            elif "data" in data and isinstance(data["data"], list):
                records = data["data"]
            else:
                records = None
                for k, v in data.items():
                    if isinstance(v, list) and len(v) > 0 and isinstance(v[0], dict):
                        records = v
                        break
            
            if records and len(records) > 0:
                all_records.extend(records)
                print(f"Page {page}: got {len(records)} records, total so far: {len(all_records)}", flush=True)
                
                # Check pagination
                total = data.get("total", data.get("total_count", 0))
                if len(all_records) >= total or total == 0:
                    break
                page += 1
            else:
                print(f"Page {page}: no more records", flush=True)
                break
    except Exception as e:
        print(f"Error on page {page}: {e}", flush=True)
        break

print(f"\nTotal records: {len(all_records)}", flush=True)

if all_records:
    print(f"Keys: {list(all_records[0].keys())}", flush=True)
    
    # Count world heritage
    world_count = sum(1 for r in all_records if r.get("protection_level", "") == "世界遗产")
    print(f"World heritage count: {world_count}", flush=True)
    
    # Get unique types
    types = list(set(r.get("type", "") for r in all_records if r.get("type")))
    print(f"Types: {types}", flush=True)
    
    # Find oldest era record
    # Assuming there's an 'era' or 'year' field
    era_field = None
    for k in ["era", "year", "dynasty", "period", "年代"]:
        if k in all_records[0]:
            era_field = k
            break
    
    if era_field:
        print(f"Using era field: {era_field}", flush=True)
        # Sort by era - need to handle the sorting logic
        # Try to find the earliest by comparing values
        oldest = None
        oldest_val = None
        for r in all_records:
            val = r.get(era_field)
            if val:
                if oldest_val is None or val < oldest_val:
                    oldest_val = val
                    oldest = r.get("name", "")
        print(f"Oldest era record: {oldest} ({oldest_val})", flush=True)
    else:
        print("No era field found, checking all fields:", flush=True)
        print({k: all_records[0].get(k) for k in all_records[0].keys()}, flush=True)
    
    # Build answer
    result = {
        "city": "南京",
        "total_count": len(all_records),
        "world_heritage_count": world_count,
        "types": types,
        "oldest_era": oldest if era_field else ""
    }
    print(f"\nFinal Answer: {json.dumps(result, ensure_ascii=False)}", flush=True)
else:
    print("No records found!", flush=True)
