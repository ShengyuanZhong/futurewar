    oldest_name = ""
    if era_field:
        # Sort by era value (string comparison usually works for Chinese dynasties if ordered chronologically)
        # Or try to find the one with earliest value
        sorted_records = sorted([r for r in all_records if r.get(era_field)], key=lambda x: x[era_field])
        if sorted_records:
            oldest_name = sorted_records[0].get("name", "")
    
    result = {
        "city": "南京",
        "total_count": len(all_records),
