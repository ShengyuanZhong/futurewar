executeCmd: python3 - <<'PY'
import urllib.request
import json
from urllib.parse import quote

base = "http://localhost:8899"
key = "heritage-api-key-2024"

all_records = []
page = 1
while True:
    city_encoded = quote("成都", encoding='utf-8')
    url = f"{base}/api/v1/heritage/search?city={city_encoded}&page={page}&limit=100"
    req = urllib.request.Request(url)
    req.add_header("X-API-Key", key)
    
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode('utf-8'))
            
            records = data.get("records", data.get("data", data.get("results", [])))
            if not isinstance(records, list):
                for k, v in data.items():
                    if isinstance(v, list) and len(v) > 0 and isinstance(v[0], dict):
                        records = v
                        break
            
            if records:
                all_records.extend(records)
                print(f"Page {page}: {len(records)} records, total so far: {len(all_records)}", flush=True)
                total = data.get("total", data.get("total_count", 0))
                if len(all_records) >= total or len(records) < 100:
                    break
                page += 1
            else:
                print(f"Page {page}: no records", flush=True)
                break
    except Exception as e:
        print(f"Error on page {page}: {e}", flush=True)
        break

print(f"\nTotal records fetched: {len(all_records)}", flush=True)

if all_records:
    print(f"Sample record keys: {list(all_records[0].keys())}", flush=True)
    
    world_count = sum(1 for r in all_records if r.get("protection_level") == "世界遗产")
    print(f"World heritage count: {world_count}", flush=True)
    
    types = list(set(r.get("type", "") for r in all_records if r.get("type")))
    print(f"Types: {types}", flush=True)
    
    # Find era field
    era_field = None
    for k in ["era", "year", "dynasty", "period", "年代", "century"]:
        if k in all_records[0]:
            era_field = k
            break
    
    print(f"Era field found: {era_field}", flush=True)
    
    oldest_name = ""
    if era_field:
        # Get all records with era values
        records_with_era = [(r.get(era_field), r.get("name", "")) for r in all_records if r.get(era_field)]
        if records_with_era:
            # Sort by era string value (chronological order in Chinese usually works with string sort)
            records_with_era.sort(key=lambda x: x[0])
            oldest_name = records_with_era[0][1]
            print(f"Oldest era record: {oldest_name} ({records_with_era[0][0]})", flush=True)
    
    result = {
        "city": "成都",
        "total_count": len(all_records),
        "world_heritage_count": world_count,
        "types": types,
        "oldest_era": oldest_name
    }
    print(f"\nFinal Answer: {json.dumps(result, ensure_ascii=False)}", flush=True)
else:
    print("No records found!", flush=True)
