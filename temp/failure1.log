import urllib.request
import json
import sys

base = "http://localhost:8899"
key = "heritage-api-key-2024"

# Step 1: Try to fetch all Beijing heritage records
# Based on docs, endpoint is /api/v1/heritage/search with city=北京
# Try with pagination parameters to get all records

all_records = []
page = 1
while True:
    url = f"{base}/api/v1/heritage/search?city=北京&page={page}&limit=100"
    req = urllib.request.Request(url)
    req.add_header("X-API-Key", key)
    
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode('utf-8'))
            print(f"Page {page} response keys: {list(data.keys())}", flush=True)
            print(f"Page {page} sample: {json.dumps(data, ensure_ascii=False)[:500]}", flush=True)
            
            # Check for records array
            if "records" in data:
                records = data["records"]
            elif "data" in data and isinstance(data["data"], list):
                records = data["data"]
            elif "results" in data:
                records = data["results"]
            else:
                print(f"Unknown structure, trying to find list", flush=True)
                # Try to find any list in the response
                records = None
                for k, v in data.items():
                    if isinstance(v, list) and len(v) > 0 and isinstance(v[0], dict):
                        records = v
                        break
            
            if records and len(records) > 0:
                all_records.extend(records)
                print(f"Got {len(records)} records on page {page}", flush=True)
                # Check if there are more pages
                total = data.get("total", data.get("total_count", len(records)))
                if len(all_records) >= total:
                    break
                page += 1
            else:
                print(f"No more records on page {page}", flush=True)
                break
                
    except Exception as e:
        print(f"Error on page {page}: {e}", flush=True)
        break

print(f"\nTotal records fetched: {len(all_records)}", flush=True)
if all_records:
    print(f"First record keys: {list(all_records[0].keys())}", flush=True)
    print(f"First record: {json.dumps(all_records[0], ensure_ascii=False)}", flush=True)
    
    # Save raw data for analysis
    with open("/tmp/beijing_heritage.json", "w") as f:
        json.dump(all_records, f, ensure_ascii=False)
    print("Saved to /tmp/beijing_heritage.json", flush=True)
