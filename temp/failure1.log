import urllib.request
import json
from urllib.parse import quote

base = "http://localhost:8899"
key = "heritage-api-key-2024"

all_records = []
page = 1
while True:
    city_encoded = quote("南京", encoding='utf-8')
    url = f"{base}/api/v1/heritage/search?city={city_encoded}&page={page}&limit=100"
    req = urllib.request.Request(url)
    req.add_header("X-API-Key", key)
    
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode('utf-8'))
            
            # Find records list
            records = data.get("records", data.get("data", data.get("results", [])))
            if not isinstance(records, list):
                # Try to find any list of dicts
                for k, v in data.items():
                    if isinstance(v, list) and len(v) > 0 and isinstance(v[0], dict):
                        records = v
                        break
            
            if records:
                all_records.extend(records)
                print(f"Page {page}: {len(records)} records, total: {len(all_records)}", flush=True)
                total = data.get("total", data.get("total_count", 0))
                if len(all_records) >= total or len(records) < 100:
                    break
                page += 1
            else:
                break
    except Exception as e:
        print(f"Error: {e}", flush=True)
        break

print(f"Total: {len(all_records)}", flush=True)
if all_records:
    world_count = sum(1 for r in all_records if r.get("protection_level") == "世界遗产")
    types = list(set(r.get("type", "") for r in all_records if r.get("type")))
    
    # Find oldest era
    era_field = None
    for k in ["era", "year", "dynasty", "period", "年代"]:
        if k in all_records[0]:
            era_field = k
            break
    
    oldest_name = ""
    if era_field:
        # Sort by era value (string comparison usually works for Chinese dynasties if ordered chronologically)
        # Or try to find the one with earliest value
        sorted_records = sorted([r for r in all_records if r.get(era_field)], key=lambda x: x[era_field])
        if sorted_records:
            oldest_name = sorted_records[0].get("name", "")
    
    result = {
        "city": "南京",
        "total_count": len(all_records),
        "world_heritage_count": world_count,
        "types": types,
        "oldest_era": oldest_name
    }
    print(f"Answer: {json.dumps(result, ensure_ascii=False)}", flush=True)
else:
    print("No records", flush=True)
