import urllib.request
import json
import sys

base = "http://localhost:8899"
key = "heritage-api-key-2024"

# Fix encoding issue by using bytes for URL and decoding response properly
# The error was 'ascii' codec can't encode characters - likely urllib issue with Chinese chars in URL
# Use urllib.parse.quote for proper URL encoding
from urllib.parse import quote

city_encoded = quote("北京", encoding='utf-8')
url = f"{base}/api/v1/heritage/search?city={city_encoded}&page=1&limit=100"
print(f"URL: {url}", flush=True)

req = urllib.request.Request(url)
req.add_header("X-API-Key", key)

try:
    with urllib.request.urlopen(req, timeout=30) as resp:
        raw = resp.read()
        # Decode as utf-8
        text = raw.decode('utf-8')
        print(f"Response length: {len(text)}", flush=True)
        print(f"First 1000 chars: {text[:1000]}", flush=True)
        data = json.loads(text)
        print(f"Keys: {list(data.keys())}", flush=True)
        
        # Save raw response
        with open("/tmp/api_response.json", "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False)
        print("Saved to /tmp/api_response.json", flush=True)
        
        # Analyze structure
        if "records" in data:
            records = data["records"]
            print(f"Records count: {len(records)}", flush=True)
            if records:
                print(f"First record keys: {list(records[0].keys())}", flush=True)
                print(f"First record: {json.dumps(records[0], ensure_ascii=False)}", flush=True)
        elif "data" in data:
            d = data["data"]
            if isinstance(d, list):
                print(f"Data list count: {len(d)}", flush=True)
                if d:
                    print(f"First data keys: {list(d[0].keys())}", flush=True)
            else:
                print(f"Data type: {type(d)}, keys: {list(d.keys()) if isinstance(d, dict) else 'N/A'}", flush=True)
                
except Exception as e:
    print(f"Error: {e}", flush=True)
    import traceback
    traceback.print_exc()
