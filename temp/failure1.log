    {"X-API-Key": "heritage-api-key-2024"},
    {"apikey": "heritage-api-key-2024"},
]

city_encoded = quote("南京", encoding='utf-8')

success = False
for auth in auth_options:
    url = f"{base}/api/v1/heritage/search?city={city_encoded}&page=1&limit=100"
    req = urllib.request.Request(url)
    for k, v in auth.items():
        req.add_header(k, v)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read().decode('utf-8')
            data = json.loads(raw)
            print(f"Auth {list(auth.keys())[0]} worked!", flush=True)
            print(f"Keys: {list(data.keys())}", flush=True)
            print(f"Raw (first 1000): {raw[:1000]}", flush=True)
            
            # Save raw response for analysis
            with open("/tmp/nanjing_raw.json", "w") as f:
                f.write(raw)
            success = True
            break
    except Exception as e:
        print(f"Auth {auth} failed: {e}", flush=True)

if not success:
    # Try without any auth just in case
    try:
        url = f"{base}/api/v1/heritage/search?city={city_encoded}&page=1&limit=100"
        with urllib.request.urlopen(url, timeout=30) as resp:
