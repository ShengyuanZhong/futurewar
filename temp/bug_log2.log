executeCmd: cd /tmp/selfEvolutionTask/1-fixed-step/4-script-dev && python3 << 'EOF'
import json

# 读取样例以归纳规则
with open('test_cases/s1_cases.json') as f:
    cases = json.load(f)['cases']

# 读取输入数据
with open('work/input_s1.json') as f:
    input_data = json.load(f)

def transform(records):
    # 规则归纳：
    # 1. 过滤掉 disabled == true 的记录
    # 2. 按 category 分组，累加 amount
    # 3. 按 category 字母顺序排序
    
    # 过滤
    active = [r for r in records if not r.get('disabled', False)]
    
    # 分组累加
    grouped = {}
    for r in active:
        cat = r['category']
        grouped[cat] = grouped.get(cat, 0) + r['amount']
    
    # 构建结果并按 category 排序
    result = []
    for cat in sorted(grouped.keys()):
        result.append({"category": cat, "amount": grouped[cat]})
    
    return result

# 处理输入数据
result = transform(input_data)

# 写入结果
with open('work/result_s1.json', 'w') as f:
    json.dump(result, f, indent=2)

print("Result written. Sample:", result[:3])
