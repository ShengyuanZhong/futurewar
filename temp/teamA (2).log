import sys, json

data = json.load(sys.stdin)

# Handle pagination or direct list
if isinstance(data, dict):
    records = data.get("data", [])
    if not records and "records" in data:
        records = data.get("records", [])
elif isinstance(data, list):
    records = data
else:
    records = []

total_count = len(records)
world_heritage_count = sum(1 for r in records if r.get("protection_level") == "世界遗产")
types = list(set(r.get("heritage_type") for r in records if r.get("heritage_type")))

# Find oldest era
# Assuming era is a string like "先秦", "汉", etc. We need a heuristic or specific field.
# Let's print the era field for all to determine sorting logic if needed, 
# but typically "oldest_era" in these tasks refers to the name of the heritage with the earliest era.
# Let's inspect the era field values first.
print("Total:", total_count)
print("World Heritage:", world_heritage_count)
print("Types:", types)
print("Sample Eras:", [r.get("era") for r in records[:5]])
print("All Eras:", set(r.get("era") for r in records))

# Heuristic for oldest: usually pre-Qin > Qin/Han > etc. 
# Let\'s define a simple order map based on common Chinese history if needed, 
# or just find the one with the earliest known period.
# Common order: 旧石器时代, 新石器时代, 先秦, 夏, 商, 周, 秦, 汉, 三国, 晋, 南北朝, 隋, 唐, 五代, 宋, 元, 明, 清, 民国, 现代

era_order = {
    "旧石器时代": 1, "新石器时代": 2, "先秦": 3, "夏": 4, "商": 5, "周": 6, "秦": 7, 
    "汉": 8, "三国": 9, "晋": 10, "南北朝": 11, "隋": 12, "唐": 13, "五代": 14, 
    "宋": 15, "元": 16, "明": 17, "清": 18, "民国": 19, "现代": 20, "近代": 19
}

oldest_name = None
min_rank = 999

for r in records:
    era = r.get("era", "")
    rank = era_order.get(era, 999)
    if rank < min_rank:
        min_rank = rank
        oldest_name = r.get("name")

print("Oldest Name:", oldest_name)

result = {
    "city": "南京",
    "total_count": total_count,
    "world_heritage_count": world_heritage_count,
    "types": types,
    "oldest_era": oldest_name
}
print("RESULT_JSON:", json.dumps(result, ensure_ascii=False))
