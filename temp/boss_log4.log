import re
from collections import defaultdict

errors = {"monitor": 0, "gateway": 0, "logistics": 0}
hour_counts = defaultdict(int)

# Monitor: [2024-03-25 08:46:00] ERROR ...
with open('monitor_2024-03-25.log') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        m = re.match(r'\[(\d{4}-\d{2}-\d{2} (\d{2}):\d{2}:\d{2})\]\s+(\w+)', line)
        if m:
            hour = m.group(2)
            level = m.group(3)
            if level == 'ERROR':
                errors["monitor"] += 1
                hour_counts[hour] += 1

# Gateway: IP - - [25/Mar/2024:09:17:00 +0800] "GET ..." 500
with open('gateway_2024-03-25.log') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        m = re.search(r'\[\d+/\w+/\d+:(\d{2}):\d{2}:\d{2}', line)
        status_m = re.search(r'"\s+(\d{3})\s*$', line)
        if m and status_m:
            hour = m.group(1)
            status = int(status_m.group(1))
            if status >= 500:
                errors["gateway"] += 1
                hour_counts[hour] += 1

# Logistics: Mar 25 10:31:00 ... OOM-killer / disk-full / net-down
with open('logistics_2024-03-25.log') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        m = re.match(r'\w+ \d+ (\d{2}):\d{2}:\d{2}', line)
        if m:
            hour = m.group(1)
            if any(line.endswith(sig) or ('daemon: ' + sig) in line for sig in ['OOM-killer', 'disk-full', 'net-down']):
                # More precise: check if the signal part starts with these
                if re.search(r'daemon:\s*(OOM-killer|disk-full|net-down)', line):
                    errors["logistics"] += 1
                    hour_counts[hour] += 1

# Find peak hour
peak_hour = ''
peak_count = 0
for h in sorted(hour_counts.keys()):
    if hour_counts[h] > peak_count:
        peak_count = hour_counts[h]
        peak_hour = h

result = {
    "errors": errors,
    "peak_hour": peak_hour + "时",
    "peak_count": peak_count
}
print(result)
EOF
