executeCmd: cd /tmp/selfEvolutionTask/1-fixed-step/4-script-dev && cat > solve.py << 'EOF'
import json

def transform(records):
    # Filter out disabled records
    active = [r for r in records if not r.get('disabled', False)]
    
    # Group by category and sum amount
    groups = {}
    for r in active:
        cat = r['category']
        if cat not in groups:
            groups[cat] = 0
        groups[cat] += r['amount']
    
    # Create result list sorted by category alphabetically
    result = []
    for cat in sorted(groups.keys()):
        result.append({"category": cat, "amount": groups[cat]})
    
    return result

# Test with public cases
with open('test_cases/s1_cases.json') as f:
    test_data = json.load(f)

all_pass = True
for i, case in enumerate(test_data['cases']):
    expected = case['expected']
    actual = transform(case['input'])
    if actual != expected:
        print(f"Case {i} FAILED")
        print(f"  Expected: {expected}")
        print(f"  Actual:   {actual}")
        all_pass = False

if all_pass:
    print("All test cases passed!")
    # Process actual input
    with open('work/input_s1.json') as f:
        input_data = json.load(f)
    result = transform(input_data)
    with open('work/result_s1.json', 'w') as f:
        json.dump(result, f)
    print("Result written to work/result_s1.json")
else:
    print("Some test cases failed")
EOF
