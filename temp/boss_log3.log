executeCmd: cd /tmp/selfEvolutionTask/1-fixed-step/4-script-dev && cat > solve.py << 'EOF'
import json

def transform(records):
    # Filter out disabled records
    active = [r for r in records if not r.get('disabled', False)]
    
    # Group by category and sum amount
    category_sums = {}
    for r in active:
        cat = r['category']
        amt = r['amount']
        if cat not in category_sums:
            category_sums[cat] = 0
        category_sums[cat] += amt
    
    # Create result list and sort by category alphabetically
    result = [{'category': cat, 'amount': total} for cat, total in category_sums.items()]
    result.sort(key=lambda x: x['category'])
    
    return result

if __name__ == '__main__':
    with open('work/input_s1.json', 'r') as f:
        data = json.load(f)
    
    output = transform(data)
    
    with open('work/result_s1.json', 'w') as f:
        json.dump(output, f, indent=2)
    
    print(f"Processed {len(data)} records into {len(output)} categories")
EOF
